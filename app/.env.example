# Default backend base URL baked into the build (no trailing slash, no /api/v1). Use your laptop LAN or Tailscale IP, not localhost.
# Users can override it at runtime under "Server settings" on the sign-in screen (stored on-device), so an IP change needs no rebuild.
EXPO_PUBLIC_API_URL=http://<laptop-LAN-or-Tailscale-IP>:8077
