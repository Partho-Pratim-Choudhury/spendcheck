# Copy to .env (git-ignored) and fill in. Read by docker compose and by the API
# (api/ loads ../.env on startup).

# --- Database (docker-compose Postgres, host port 5433) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=spendcheck
DB_USER=spendcheck
# Generate: openssl rand -base64 24
DB_PASSWORD=

# --- API ---
SERVER_PORT=8077
# At least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=

# Single app user, seeded on first start
APP_USER_EMAIL=you@example.com
APP_USER_PASSWORD=
APP_USER_NAME=Partho
APP_SALARY_DAY=7

# --- OpenAI (your own API key; used from week 3) ---
OPENAI_API_KEY=
LLM_MODEL=
STT_MODEL=

# Sign-up invite code — friends enter this to register. Unset = sign-ups closed.
SIGNUP_INVITE_CODE=
